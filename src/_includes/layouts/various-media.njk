---
layout: "layouts/base.njk"
---

<div class="vm-container">
  <div class="vm-header">
    <a href="/projects/various/" class="back-link">← Back to Various</a>
    {% if title %}
    <h1>{{ title }}</h1>
    {% endif %}
  </div>

  {% if variousMediaItems and variousMediaItems.length > 0 %}
  <div class="vm-list">
    {% for item in variousMediaItems %}
    <article class="vm-item">
      {% if item.title %}
      <h2 class="vm-item-title">{{ item.title }}</h2>
      {% endif %}

      <div class="vm-media-wrapper">
        {% if item.type == 'youtube' %}
        <div class="vm-video-embed">
          <iframe
            src="https://www.youtube.com/embed/{{ item.youtubeId }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>
        {% elif item.type == 'soundcloud' %}
        <div class="vm-soundcloud-embed">
          <iframe
            width="100%"
            height="166"
            scrolling="no"
            frameborder="no"
            allow="autoplay"
            src="{{ item.soundcloudEmbedUrl }}">
          </iframe>
        </div>
        {% endif %}
      </div>

      {% if item.description and item.description.trim() %}
      <div class="vm-item-description">{{ item.description | md | safe }}</div>
      {% endif %}
    </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="vm-empty">
    <p>No media available at the moment.</p>
  </div>
  {% endif %}
</div>

<style>
  .vm-container {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--size-xl) var(--size-m);
  }

  .vm-header {
    margin-bottom: var(--size-xl);
  }

  .vm-header .back-link {
    display: inline-block;
    margin-bottom: var(--size-m);
    color: var(--color-text-light);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .vm-header .back-link:hover {
    color: var(--color-text);
  }

  .vm-header h1 {
    font-size: 2.5rem;
    font-weight: normal;
    margin: 0;
  }

  .vm-list {
    display: flex;
    flex-direction: column;
    gap: var(--size-xl);
  }

  .vm-item {
    display: flex;
    flex-direction: column;
    gap: var(--size-m);
  }

  .vm-item-title {
    font-size: 1.4rem;
    font-weight: normal;
    margin: 0;
    color: var(--color-text);
  }

  .vm-video-embed {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
  }

  .vm-video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .vm-soundcloud-embed {
    border-radius: 4px;
    overflow: hidden;
  }

  .vm-soundcloud-embed iframe {
    display: block;
  }

  .vm-item-description {
    color: var(--color-text-light);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }

  .vm-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--color-text-light);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .vm-container { padding: var(--size-m) var(--size-s, 1rem); }
    .vm-header h1 { font-size: 1.8rem; }
    .vm-list { gap: var(--size-l); }
  }

  @media (max-width: 480px) {
    .vm-header h1 { font-size: 1.5rem; }
    .vm-item-title { font-size: 1.2rem; }
  }
</style>
