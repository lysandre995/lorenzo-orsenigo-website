{# One news entry: cover on the left, text on the right. Expects `item` from news.json. #}
<div class="news-item">
  <div class="news-image">
    {% if item.image %}
      <img src="{{ item.image }}" alt="{{ item.title }}" loading="lazy">
    {% else %}
      <div class="news-image-placeholder" aria-hidden="true"></div>
    {% endif %}
  </div>
  <div class="news-content">
    {% if item.date %}
      <time class="news-date" datetime="{{ item.date }}">{{ item.date | formatDay }}</time>
    {% endif %}
    <h3 class="news-item-title">{{ item.title }}</h3>
    {% if item.text %}
      <div class="news-text">{{ item.text | md | safe }}</div>
    {% endif %}
    {% if item.link and item.link.url %}
      <a href="{{ item.link.url }}" class="news-link" target="_blank" rel="noopener noreferrer">{{ item.link.label | default("More info") }} →</a>
    {% endif %}
  </div>
</div>
